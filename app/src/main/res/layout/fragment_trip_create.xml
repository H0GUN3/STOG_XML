<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/space_large">
        <include
            android:id="@+id/trip_dates_card"
            layout="@layout/view_trip_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:hint="@string/trip_region_label">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/trip_region_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLength="100"
                android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginTop="@dimen/space_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/trip_name_label">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/trip_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="100"
                android:saveEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Holds the selected ISO dates for the draft; the card above is the visible control. -->
        <EditText
            android:id="@+id/trip_start_input"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:importantForAutofill="no"
            android:inputType="date"
            android:visibility="gone" />
        <EditText
            android:id="@+id/trip_end_input"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:importantForAutofill="no"
            android:inputType="date"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trip_create_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:minHeight="@dimen/control_min_height"
            android:text="@string/trip_create_submit" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trip_create_status"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
