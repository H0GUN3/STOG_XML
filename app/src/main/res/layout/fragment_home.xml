<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/banner_height"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ViewFlipper
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="@integer/banner_flip_interval_ms">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/banner_coast_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_coast" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/banner_planning_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_planning" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/banner_cells_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_cells" />
            </ViewFlipper>
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_banner_scrim"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/card_padding"
                android:paddingBottom="@dimen/home_banner_text_bottom">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/home_greeting"
                    style="@style/TextAppearance.Material3.HeadlineSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_greeting"
                    android:textColor="@color/stog_on_banner" />
                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting_body"
                    android:textColor="@color/stog_on_banner" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
    style="@style/Widget.STOG.Card.Raised"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_medium"
            android:layout_marginTop="@dimen/home_stat_overlap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_medium">
                <include
                    android:id="@+id/home_stat_trips"
                    layout="@layout/view_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <View
                    android:layout_width="@dimen/divider_thickness"
                    android:layout_height="match_parent"
                    android:background="?attr/colorOutlineVariant"
                    android:importantForAccessibility="no" />
                <include
                    android:id="@+id/home_stat_cells"
                    layout="@layout/view_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <View
                    android:layout_width="@dimen/divider_thickness"
                    android:layout_height="match_parent"
                    android:background="?attr/colorOutlineVariant"
                    android:importantForAccessibility="no" />
                <include
                    android:id="@+id/home_stat_regions"
                    layout="@layout/view_home_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/home_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_extra_large"
            android:indeterminate="true" />

        <LinearLayout
            android:id="@+id/home_trip_section"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_extra_large"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_section_trips" />
            <LinearLayout
                android:id="@+id/home_trip_cards"
                android:layout_marginTop="@dimen/space_medium"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_empty_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_extra_large"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.TitleLarge"
                android:id="@+id/home_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/home_empty_body"
                android:layout_marginTop="@dimen/space_small"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_create_action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_min_height"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:layout_marginTop="@dimen/space_large" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_error_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_extra_large"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_error_title" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_retry_action"
                style="@style/Widget.STOG.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_min_height"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/home_retry_action" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
