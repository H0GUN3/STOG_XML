<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_row"
    style="@style/Widget.STOG.Card.Raised"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_medium"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:minHeight="@dimen/home_trip_card_min_height"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/colorSurfaceContainer">
            <ImageView
                android:id="@+id/trip_row_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trip_row_cover_status"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/stog_banner_scrim"
                android:gravity="center"
                android:paddingVertical="@dimen/grid_gap"
                android:text="@string/trip_card_cover_error"
                android:textColor="@color/stog_on_banner"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_medium"
            android:paddingVertical="@dimen/space_small">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trip_row_status"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trip_row_name"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/grid_gap"
                android:ellipsize="end"
                android:maxLines="1" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trip_row_meta"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trip_row_place"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
