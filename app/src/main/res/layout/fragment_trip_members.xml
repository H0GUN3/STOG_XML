<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding_horizontal" android:paddingVertical="@dimen/space_large">
    <com.google.android.material.textview.MaterialTextView style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trip_members_body" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/trip_members_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_medium" android:contentDescription="@string/trip_members_loading" android:indeterminate="true" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/trip_members_list"
            android:layout_marginHorizontal="@dimen/card_shadow_outset"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/card_shadow_inset"
            android:paddingTop="@dimen/card_shadow_inset" android:layout_width="match_parent" android:layout_height="@dimen/member_list_height" android:layout_marginTop="@dimen/space_medium" />
    <com.google.android.material.textview.MaterialTextView android:id="@+id/trip_members_status" style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_medium" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/trip_members_retry" style="@style/Widget.STOG.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_small" android:text="@string/trips_retry" android:visibility="gone" />
</LinearLayout>
