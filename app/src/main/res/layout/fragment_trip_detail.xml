<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_vertical">
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/trip_detail_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/trip_detail_loading"
            android:indeterminate="true"
            android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trip_cover_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">
                <ImageView
                    android:id="@+id/trip_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cover_detail_height"
                    android:contentDescription="@string/trip_cover_image_description"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/trip_cover_status"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_cover_select"
                    style="@style/Widget.STOG.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_cover_select" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_cover_upload"
                    style="@style/Widget.STOG.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_cover_upload" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_cover_remove"
                    style="@style/Widget.STOG.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_cover_remove" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trip_detail_name"
            style="@style/TextAppearance.Material3.HeadlineMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trip_detail_meta"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">
                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_basket_title"
                    android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_add_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_add_place_action" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/trip_basket_status"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/trip_collaboration_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">
                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_collaboration_title"
                    android:textColor="?attr/colorOnSurface" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trip_detail_edit"
                        style="@style/Widget.STOG.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/control_min_height"
                        android:text="@string/trip_edit_action" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trip_detail_members"
                        style="@style/Widget.STOG.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_small"
                        android:layout_weight="1"
                        android:minHeight="@dimen/control_min_height"
                        android:text="@string/trip_members_action" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trip_detail_share"
                        style="@style/Widget.STOG.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/control_min_height"
                        android:text="@string/trip_share_action" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trip_detail_stop_share"
                        style="@style/Widget.STOG.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/control_min_height"
                        android:text="@string/trip_stop_share_action" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_detail_leave"
                    style="@style/Widget.STOG.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_leave_action" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/trip_detail_delete"
                    style="@style/Widget.STOG.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:minHeight="@dimen/control_min_height"
                    android:text="@string/trip_delete_action" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/trip_detail_collaboration_status"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_medium"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/trip_detail_retry"
            style="@style/Widget.STOG.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/trips_retry"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
